# Canonical public URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://creator-launch-os-starlight-intelligence.vercel.app

# Public contact address shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=studio@example.com

# Optional hosted checkout URLs. Leave blank to keep the honest demo checkout.
# These values may be public URLs. Never place provider API keys here.
NEXT_PUBLIC_CHECKOUT_GUIDE_URL=
NEXT_PUBLIC_CHECKOUT_CONSOLE_URL=
NEXT_PUBLIC_CHECKOUT_AUDIO_URL=
