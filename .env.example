# Optional canonical URL override. Vercel's production project URL is used when blank.
NEXT_PUBLIC_SITE_URL=

# Optional public contact address. Leave blank to show the source-repository CTA.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional hosted checkout URLs. Leave blank to keep the honest demo checkout.
# These values may be public URLs. Never place provider API keys here.
NEXT_PUBLIC_CHECKOUT_GUIDE_URL=
NEXT_PUBLIC_CHECKOUT_CONSOLE_URL=
NEXT_PUBLIC_CHECKOUT_AUDIO_URL=

# Optional Commercial Kit commerce. Leave all blank: /kit shows "Available soon"
# and the commerce routes refuse every request.
# COMMERCE_MODE: off (default) | test | live. Test mode only accepts fixture
# events and is refused on a production deployment.
COMMERCE_MODE=
# fixture in test mode. A live merchant adapter is added once one merchant is chosen.
COMMERCE_MERCHANT=
# Server-only secrets, 32+ characters. Set them in the host's encrypted settings, never here.
COMMERCE_WEBHOOK_SECRET=
COMMERCE_DELIVERY_SECRET=
# Hosted HTTPS checkout link for the kit, live mode only. Public; never a key.
NEXT_PUBLIC_KIT_CHECKOUT_URL=
