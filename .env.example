# Optional: canonical public origin for metadata and sitemaps
NEXT_PUBLIC_SITE_URL=

# Optional: public support inbox shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: HTTPS hosted checkout URLs for the sample catalog
NEXT_PUBLIC_CHECKOUT_GUIDE_URL=
NEXT_PUBLIC_CHECKOUT_CONSOLE_URL=
NEXT_PUBLIC_CHECKOUT_AUDIO_URL=

# Optional: Commercial kit commerce adapter (leave unset to keep checkout off)
COMMERCE_MODE=
COMMERCE_MERCHANT=
COMMERCE_WEBHOOK_SECRET=
COMMERCE_DELIVERY_SECRET=
NEXT_PUBLIC_KIT_CHECKOUT_URL=

# Required for live waitlist capture (/api/waitlist fails closed with 503 when unset)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Resend double-opt-in and audience sync for waitlist
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_AUDIENCE_ID__CREATOR_LAUNCH_OS=
