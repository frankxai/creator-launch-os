# Optional canonical URL override. Vercel's production project URL is used when blank.
NEXT_PUBLIC_SITE_URL=

# Optional public contact address. Leave blank to show the source-repository CTA.
NEXT_PUBLIC_CONTACT_EMAIL=

# Checkout is NOT configured here. Prices and hosted checkout URLs live in
# storefront.config.json, one rail per product, validated by:
#
#   node bin/validate-storefront.mjs
#
# Never place provider API keys, webhook secrets, or fulfillment credentials in
# any NEXT_PUBLIC_ variable or in the storefront config. Both are public.
