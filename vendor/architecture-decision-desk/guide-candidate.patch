new file mode 100644
index 0000000..c724e88
--- /dev/null
+++ b/scripts/build-browser-kit.mjs
@@ -0,0 +1,60 @@
+import { createHash } from 'node:crypto';
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const digest = value => createHash('sha256').update(value).digest('hex');
+const prefix = `#!/usr/bin/env node
+// Local planning and declared-measurement report. No providers or external actions.
+import { createHash } from 'node:crypto';
+import { closeSync, constants, fstatSync, openSync, readFileSync, readSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const MAX_BYTES = 1024 * 1024;
+const sha256 = value => createHash('sha256').update(value).digest('hex');
+`;
+const endMarker = '\nfunction readInput(path) {';
+const names = ['validateDecision', 'analyzeDecision', 'renderMarkdown'];
+
+/** Project the canonical pure functions verbatim; never maintain a second implementation. */
+export function browserProjection(source, exampleText) {
+  if (!source.startsWith(prefix) || source.indexOf(endMarker) !== source.lastIndexOf(endMarker) ||
+      !source.includes(endMarker) || !source.slice(prefix.length).startsWith('const fail = path =>')) {
+    throw new Error('Canonical review markers changed; inspect the source boundary before regenerating.');
+  }
+  const pure = source.slice(prefix.length, source.indexOf(endMarker));
+  for (const name of names) {
+    if (pure.split(`export function ${name}(`).length !== 2) throw new Error(`Canonical export changed: ${name}`);
+  }
+  if ((pure.match(/^export /gm) ?? []).length !== names.length || /\b(?:import|process|Buffer|readFileSync|createHash|sha256|fileURLToPath)\b/.test(pure)) {
+    throw new Error('Unexpected executable dependency inside the canonical pure boundary.');
+  }
+  const example = JSON.parse(exampleText);
+  const metadata = { schemaVersion: 1, sourceRevision: 'd2bf5e778d5c4f08a1196551d32b90acf4244bec',
+    designRevision: '212db86fa4582616378e4a9ecf7743d3ba6d1747', sourceSha256: digest(source), exampleSha256: digest(exampleText) };
+  const code = pure.replace(/^export function /gm, 'function ');
+  return `// GENERATED by scripts/build-browser-kit.mjs. Do not edit. MIT; retain the repository LICENSE.\n// Source SHA-256: ${metadata.sourceSha256}\n(function () {\n'use strict';\n${code}\nconst exampleDecision = ${JSON.stringify(example)};\nvalidateDecision(exampleDecision);\nglobalThis.ArchitectureReview = Object.freeze({ validateDecision, analyzeDecision, renderMarkdown, exampleDecision, metadata: Object.freeze(${JSON.stringify(metadata)}) });\n})();\n`;
+}
+
+export function buildBrowserKit({ check = false } = {}) {
+  const expected = browserProjection(readFileSync(resolve(root, 'scripts/architecture-review.mjs'), 'utf8'),
+    readFileSync(resolve(root, 'examples/consultant-brief/decision.json'), 'utf8'));
+  const target = resolve(root, 'web/review-core.js');
+  if (check) {
+    if (readFileSync(target, 'utf8') !== expected) throw new Error('Browser projection drift: run node scripts/build-browser-kit.mjs.');
+  } else {
+    mkdirSync(dirname(target), { recursive: true });
+    writeFileSync(target, expected);
+  }
+  return { target, sha256: digest(expected) };
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  try {
+    const args = process.argv.slice(2);
+    if (args.length > 1 || (args.length === 1 && args[0] !== '--check')) throw new Error('Use no arguments to build, or --check to detect drift.');
+    console.log(JSON.stringify(buildBrowserKit({ check: args[0] === '--check' })));
+  } catch (error) { console.error(error.message); process.exitCode = 1; }
+}
