+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import vm from 'node:vm';
+import test from 'node:test';
+import { validateDecision, analyzeDecision, renderMarkdown } from './architecture-review.mjs';
+import { browserProjection, buildBrowserKit } from './build-browser-kit.mjs';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const source = readFileSync(resolve(root, 'scripts/architecture-review.mjs'), 'utf8');
+const exampleText = readFileSync(resolve(root, 'examples/consultant-brief/decision.json'), 'utf8');
+const example = () => JSON.parse(exampleText);
+function projected() {
+  const context = {};
+  vm.runInNewContext(browserProjection(source, exampleText), context, { timeout: 1000 });
+  return context.ArchitectureReview;
+}
+const plain = value => JSON.parse(JSON.stringify(value));
+
+test('generated bytes are deterministic and current; browser projection needs no Node or network globals', () => {
+  assert.deepEqual(buildBrowserKit({ check: true }).target, resolve(root, 'web/review-core.js'));
+  assert.equal(browserProjection(source, exampleText), browserProjection(source, exampleText));
+  assert.deepEqual(plain(projected().exampleDecision), example());
+});
+
+test('forecast, fixture observations, zero acceptance and declared evidence preserve exact CLI semantics', () => {
+  const browser = projected();
+  const decisions = [example()];
+  for (const evidenceMode of ['illustrative', 'declared']) {
+    const value = example();
+    value.evidenceMode = evidenceMode; value.observationWindow = 'Synthetic parity fixture; not customer evidence';
+    value.observations = [{ attemptId: '1', outcome: 'failed', modelCash: .1, infrastructureCash: .2, humanMinutes: 5, baselineMinutes: null, evidenceRef: '<script>literal reference</script>' },
+      { attemptId: '2', outcome: 'accepted', modelCash: .1, infrastructureCash: .2, humanMinutes: 5, baselineMinutes: 30, evidenceRef: 'local fixture' }];
+    decisions.push(value);
+  }
+  const zero = example(); zero.economics.expectedAcceptanceRate = 0; decisions.push(zero);
+  for (const value of decisions) {
+    assert.deepEqual(plain(browser.validateDecision(value)), validateDecision(value));
+    const result = analyzeDecision(value);
+    assert.deepEqual(plain(browser.analyzeDecision(value)), result);
+    assert.equal(browser.renderMarkdown(value, result), renderMarkdown(value, result));
+  }
+});
+
+test('malformed decisions fail in both implementations with the same field error', () => {
+  const browser = projected();
+  for (const mutate of [d => { d.extra = true; }, d => { d.chosenOption = 'absent'; }, d => { d.options[1].id = d.options[0].id; },
+    d => { d.evidenceMode = 'declared'; }, d => { d.title = '<text>\u0000'; }, d => { d.economics.expectedAcceptanceRate = 2; }]) {
+    const value = example(); mutate(value);
+    let expected;
+    try { analyzeDecision(value); } catch (error) { expected = error.message; }
+    assert.ok(expected);
+    assert.throws(() => browser.analyzeDecision(value), error => error.message === expected);
+  }
+});
+
+test('marker or executable-boundary drift fails closed', () => {
+  for (const changed of [source.replace('const fail = path =>', 'const failure = path =>'),
+    source.replace('function readInput(path) {', 'function readFile(path) {'),
+    source.replace('export function validateDecision(', 'function validateDecision('),
+    source.replace('const fail = path =>', 'const unexpected = process.env;\nconst fail = path =>'),
+    source.replace('const md = value =>', "const hidden = 'node:fs';\nimport io from 'node:fs';\nconst md = value =>")]) {
+    assert.throws(() => browserProjection(changed, exampleText));
+  }
+});
+
+test('browser UI has no HTML injection sink, remote dependency, storage or provider transport', () => {
+  const app = readFileSync(resolve(root, 'web/app.js'), 'utf8');
+  const html = readFileSync(resolve(root, 'web/index.html'), 'utf8');
+  assert.doesNotMatch(app, /innerHTML|outerHTML|insertAdjacentHTML|localStorage|sessionStorage|indexedDB|\bfetch\s*\(|XMLHttpRequest|WebSocket|eval\s*\(/);
+  assert.doesNotMatch(html, /<(?:script|link)[^>]+(?:src|href)=["']https?:/);
+  assert.match(app, /textContent/);
+  assert.match(app, /fatal: true/);
+});
